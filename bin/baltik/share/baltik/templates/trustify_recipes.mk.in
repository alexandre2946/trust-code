######################################################################
# Trustify make targets — generated by baltik_configure from
# share/baltik/templates/trustify_recipes.mk.in via
# `$TRUST_ROOT/scripts/expand_env.py`. The expander substitutes
# `@@<name>@@` tokens with the corresponding environment variable
# value at configure-time; the tokens active in this template are
# env_file, trustify_version, and configure_date. Make-time
# references (`$(CURDIR)`, `$(TRUSTIFY_CHECK_JOBS)`) and shell-time
# references (`$$TRUST_ROOT`) pass through untouched.
#
# Configured against trustify @@trustify_version@@ on @@configure_date@@.
# If your trustify version has moved on since (e.g. a CLI flag was
# renamed or a subcommand split), re-run baltik_configure to refresh
# these recipes. Audit 3.6.
######################################################################

# Trustify version this Makefile was generated against. Exposed as a
# make variable so future runtime mismatch checks can reuse it; today
# it's mostly for human inspection alongside `trustify --version`.
TRUSTIFY_VERSION_AT_CONFIGURE := @@trustify_version@@

# help trustify 	: Build trustify Python module for the baltik
# Probe trustify availability. Used as a make-level dependency by
# every trustify-using target so the recipes never run against a
# missing binary. Sources @@env_file@@ first so the probe sees the
# same PATH the actual trustify commands will. Audit 3.10.
check_trustify_install :
	@. @@env_file@@; \
	if ! command -v trustify >/dev/null 2>&1 || ! trustify --version >/dev/null 2>&1; then \
		echo "trustify not available — re-run ./configure or pip install $$TRUST_ROOT/Outils/trustify/" >&2; \
		exit 1; \
	fi

# $(CURDIR) instead of configure-time-absolute baltik path so the
# recipes resolve at make-time (audit 3.5). @@env_file@@ stays
# configure-time-absolute per project policy that baltik relocation
# requires re-running baltik_configure.
trustify : check_trustify_install
	@echo "############################"
	@echo "# Building trustify module #"
	@echo "############################"
	@rm -rf $(CURDIR)/build/trustify/generated
	@. @@env_file@@; trustify -p $(CURDIR) generate_schema --out $(CURDIR)/build/trustify/generated


.PHONY: trustify_check trustify_check_local

# help trustify_check 	: Check dataset validity using trustify, in tests/Reference of current baltik and all dependencies transitively
# Depends on `trustify`, which transitively depends on `check_trustify_install`.
trustify_check : trustify
	trustify --schema $(CURDIR)/build/trustify/generated batch-check-projects --only primary,dependency -j $(TRUSTIFY_CHECK_JOBS)

# help trustify_check_local 	: Check dataset validity using trustify generated module, in tests/Reference.
# Depends on `trustify`, which transitively depends on `check_trustify_install`.
trustify_check_local : trustify
	trustify --schema $(CURDIR)/build/trustify/generated batch-check-projects --only primary -j $(TRUSTIFY_CHECK_JOBS)

# help trustify_format_tests 	: Reformat every .data file under tests/Reference (excluding tests/Reference/Validation/) — pass --apply or set TRUSTIFY_FORCE_FORMAT=1 to actually write
# Depends on check_trustify_install directly (this target doesn't
# need a fresh schema — it formats existing .data files). The
# destructive write is opt-in at the trustify level (audit 1.10) —
# the recipe sets TRUSTIFY_FORCE_FORMAT=1 to preserve the historical
# `make trustify_format_tests` semantic. Override on the make
# command line with `TRUSTIFY_FORCE_FORMAT=` (empty) to dry-run.
trustify_format_tests : check_trustify_install
	@if [ -d "$(CURDIR)/tests/Reference" ]; then \
		echo "#####################################################"; \
		echo "# Formatting tests/Reference/ (excluding Validation) #"; \
		echo "#####################################################"; \
		. @@env_file@@; \
		TRUSTIFY_FORCE_FORMAT=1 trustify batch-format $(CURDIR)/tests/Reference --exclude Validation/; \
	else \
		echo "trustify_format_tests: skipped (no $(CURDIR)/tests/Reference)"; \
	fi

# help trustify_doc 	: Build baltik keyword documentation using trustify
trustify_doc : trustify
	@echo "######################################"
	@echo "# Building keyword doc with trustify #"
	@echo "######################################"
	@rm -rf $(CURDIR)/build/doc/trustify
	@. @@env_file@@; trustify --schema $(CURDIR)/build/trustify/generated generate_markdown --out $(CURDIR)/build/doc/trustify
	@echo "# Documentation generated at $(CURDIR)/build/doc/trustify #"

