<!DOCTYPE html>
<!--
  TRUST landing page.
  GENERATED from scripts/version/index.html.in by scripts/version/update_index.py.
  Do NOT edit index.html directly: edit the .in template, then run
      python3 scripts/version/update_index.py --apply
  Template keys (filled from ./VERSION):
    VERSION            the version string, e.g. 1.9.8_beta
    READTHEDOCS_LABEL  "latest" for a *_beta version, else "v<x.x.x>" (e.g. v1.9.8)
-->
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>TRUST Version ${VERSION}</title>

  <!-- Inter font - same as doxygen header -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    /* -- CSS variables - exact doxygen-awesome palette -- */
    :root {
      --primary-color: #1779c4;
      --primary-dark:  #335c80;
      --primary-light: #e8f2fb;
      --page-bg:       #ffffff;
      --surface:       #fbfbfb;
      --surface-border:#dedede;
      --text-primary:  #2f4153;
      --text-secondary:#6f7e8e;
      --text-muted:    #859399;
      --tag-bg:        #e8f2fb;
      --tag-text:      #1779c4;
      --shadow-sm:     0 2px 8px 0 rgba(0,0,0,.075);
      --shadow-md:     0 4px 16px 0 rgba(0,0,0,.15);
      --radius:        8px;
      --transition:    .2s ease;
    }
    [data-theme="dark"] {
      --primary-color: #1982d2;
      --primary-dark:  #86a9c4;
      --primary-light: #163750;
      --page-bg:       #1c1d1f;
      --surface:       #252628;
      --surface-border:#38393b;
      --text-primary:  #d2dbde;
      --text-secondary:#859399;
      --text-muted:    #6f7e8e;
      --tag-bg:        #163750;
      --tag-text:      #1982d2;
      --shadow-sm:     0 2px 8px 0 rgba(0,0,0,.35);
      --shadow-md:     0 4px 16px 0 rgba(0,0,0,.5);
    }

    /* -- Colorblind-friendly palette (Okabe-Ito) - orthogonal to light/dark.
       Accent uses Okabe-Ito blue; the badge uses vermillion/orange so the two
       accent roles differ by hue AND brightness, not hue alone. -- */
    [data-cb="on"] {
      --primary-color: #0072b2;
      --primary-dark:  #005a8c;
      --primary-light: #d6ebf7;
      --tag-bg:        #fbe3c8;
      --tag-text:      #a8500a;
    }
    [data-theme="dark"][data-cb="on"] {
      --primary-color: #56b4e9;
      --primary-dark:  #9bcef0;
      --primary-light: #103a54;
      --tag-bg:        #5a3a18;
      --tag-text:      #f0a85a;
    }
    /* Never convey links by color alone in colorblind mode: always underline. */
    [data-cb="on"] .card-links a,
    [data-cb="on"] footer a { text-decoration: underline; }
    /* Stronger borders in colorblind mode: outline the badge and darken card
       edges so separation does not rely on fill color alone. */
    [data-cb="on"] .card { border-color: var(--text-secondary); }
    [data-cb="on"] .badge { border: 1px solid var(--tag-text); }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--page-bg);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      transition: background var(--transition), color var(--transition);
    }

    /* -- Top bar -- */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--page-bg);
      border-bottom: 1px solid var(--surface-border);
      padding: 0 2rem;
      padding-right: 72px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(8px);
    }
    .topbar-brand {
      display: flex;
      align-items: center;
      gap: .75rem;
      text-decoration: none;
      color: inherit;
    }
    .topbar-brand img {
      height: 32px;
      width: auto;
      object-fit: contain;
    }
    .topbar-title {
      font-size: .95rem;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -.01em;
    }
    .topbar-version {
      font-size: .75rem;
      font-weight: 500;
      background: var(--primary-light);
      color: var(--primary-color);
      padding: 2px 8px;
      border-radius: 99px;
    }
    .topbar-actions {
      display: flex;
      align-items: center;
      gap: .75rem;
    }

    /* -- Dark mode toggle (matches doxygen-awesome style) -- */
    .dark-toggle {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 99px;
      padding: 5px 12px;
      cursor: pointer;
      font-size: .8rem;
      font-weight: 500;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: .4rem;
      transition: background var(--transition), color var(--transition);
    }
    .dark-toggle:hover { background: var(--primary-light); color: var(--primary-color); }
    .dark-toggle .icon { font-size: 1rem; }

    /* -- GitHub corner -- */
    .github-corner svg {
      fill: var(--primary-color);
      color: var(--page-bg);
      position: fixed;
      top: 0; right: 0;
      border: 0;
      z-index: 9999;
      transition: fill var(--transition);
    }
    .github-corner:hover .octo-arm { animation: octocat-wave 560ms ease-in-out; }
    @keyframes octocat-wave {
      0%,100%{transform:rotate(0)}20%,60%{transform:rotate(-25deg)}40%,80%{transform:rotate(10deg)}
    }


    .btn {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .5rem 1.1rem;
      border-radius: 8px;
      font-size: .85rem;
      font-weight: 600;
      text-decoration: none;
      transition: all var(--transition);
    }
    .btn-primary {
      background: var(--primary-color);
      color: #fff;
      box-shadow: var(--shadow-sm);
    }
    .btn-primary:hover { background: var(--primary-dark); box-shadow: var(--shadow-md); transform: translateY(-1px); }
    .btn-secondary {
      background: var(--surface);
      color: var(--text-primary);
      border: 1px solid var(--surface-border);
    }
    .btn-secondary:hover { background: var(--primary-light); color: var(--primary-color); border-color: var(--primary-color); }

    /* -- Main content -- */
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2.5rem 2rem 4rem;
    }

    /* -- Section -- */
    .section { margin-bottom: 2.5rem; }
    .section-header {
      display: flex;
      align-items: center;
      gap: .6rem;
      margin-bottom: 1rem;
    }
    .section-icon {
      width: 4px;
      height: 16px;
      border-radius: 2px;
      background: var(--primary-color);
      flex-shrink: 0;
    }
    .section-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -.02em;
      text-transform: uppercase;
      font-size: .75rem;
      letter-spacing: .08em;
      color: var(--text-muted);
    }

    /* -- Cards grid -- */
    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .card {
      position: relative;
      cursor: pointer;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: var(--radius);
      padding: 1.25rem 1.4rem;
      transition: all var(--transition);
      box-shadow: var(--shadow-sm);
    }
    .card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--primary-color); }
    .card-title {
      font-size: .9rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: .5rem;
    }
    .card-links {
      display: flex;
      flex-direction: column;
      gap: .35rem;
    }
    .card-links a {
      font-size: .83rem;
      color: var(--primary-color);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      transition: color var(--transition);
    }
    .card-links a:hover { color: var(--primary-dark); text-decoration: underline; }
    /* Make the whole card clickable: the first link's ::after stretches an
       overlay across the card (anchored to .card, which is position:relative).
       Extra links are raised above the overlay so they stay clickable. */
    .card-links a:first-child::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .card-links a:not(:first-child) { position: relative; z-index: 1; }
    .badge {
      font-size: .7rem;
      font-weight: 500;
      background: var(--tag-bg);
      color: var(--tag-text);
      padding: 1px 6px;
      border-radius: 4px;
      margin-left: .25rem;
    }
    .card-links a .arrow { opacity: .5; font-size: .75rem; }
    .card-desc {
      font-size: .8rem;
      color: var(--text-secondary);
      margin-bottom: .75rem;
      line-height: 1.5;
    }

    /* -- Single-link card variant -- */
    .card-link-big {
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-decoration: none;
      color: inherit;
    }
    .card-link-big .chevron { color: var(--primary-color); font-size: 1.1rem; opacity: .6; }

    /* -- Contact strip -- */
    .contact-strip {
      background: var(--primary-light);
      border: 1px solid var(--surface-border);
      border-radius: var(--radius);
      padding: 1.1rem 1.4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .contact-strip p { font-size: .88rem; color: var(--text-secondary); }
    .contact-strip strong { color: var(--text-primary); }

    /* -- Footer -- */
    footer {
      border-top: 1px solid var(--surface-border);
      padding: 1.25rem 2rem;
      text-align: center;
      font-size: .78rem;
      color: var(--text-muted);
    }
    footer a { color: var(--primary-color); text-decoration: none; }
    footer a:hover { text-decoration: underline; }

    @media (max-width: 900px) {
      .cards { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      main { padding: 1.5rem 1.25rem 3rem; }
      .topbar { padding: 0 1.25rem; padding-right: 72px; }
      .cards { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- GitHub corner (top-right octocat); edit href to change the repository -->
<a href="https://github.com/cea-trust-platform/trust-code" target="_blank" class="github-corner" title="View on GitHub" aria-label="View source on GitHub">
  <svg width="60" height="60" viewBox="0 0 250 250" aria-hidden="true">
    <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"/>
    <path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin:130px 106px" class="octo-arm"/>
    <path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor" class="octo-body"/>
  </svg>
</a>

<!-- Topbar: logo, title, version badge -->
<nav class="topbar">
  <div class="topbar-brand">
    <img src="docs/theme/favicon.ico" alt="TRUST Logo" style="height:26px;width:auto;object-fit:contain;" onerror="this.style.display='none'"/>
    <span class="topbar-title">TRUST Platform</span>
    <span class="topbar-version">v${VERSION}</span>
  </div>
  <div class="topbar-actions">
    <button class="dark-toggle" onclick="toggleTheme()" title="Toggle dark mode">
      <span id="theme-icon" style="font-size:.85rem;line-height:1">&#127769;</span>
      <span id="theme-label">Dark mode</span>
    </button>
    <button class="dark-toggle" onclick="toggleCb()" title="Toggle colorblind-friendly palette">
      <span style="font-size:.85rem;line-height:1">&#9680;</span>
      <span id="cb-label">Colorblind</span>
    </button>
  </div>
</nav>

<!-- Main content: sections of cards. To add a card, copy a .card block. -->
<main>

  <!-- Section: Documentation -->
  <section class="section">
    <div class="section-header">
      <div class="section-icon"></div>
      <span class="section-title">Documentation</span>
    </div>
    <div class="cards">

      <div class="card">
        <div class="card-title">Release Notes</div>
        <div class="card-desc">Latest changes, fixes and new features for this version.</div>
        <div class="card-links">
          <a href="RELEASE_NOTES">&#8599; Read release notes</a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">General Guide</div>
        <div class="card-desc">Overview of TRUST physics models and simulation setup.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/GeneralGuide.html" target="_blank">&#8599; Online <span class="badge">web</span></a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Numerical Methods</div>
        <div class="card-desc">Detailed description of the numerical schemes used in TRUST.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/NumericalMethods.html" target="_blank">&#8599; Online <span class="badge">web</span></a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Keywords Reference</div>
        <div class="card-desc">Full reference manual for all TRUST input keywords.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/KeywordsReference.html" target="_blank">&#8599; Online <span class="badge">web</span></a>
        </div>
      </div>

    </div>
  </section>

  <!-- Section: User Resources -->
  <section class="section">
    <div class="section-header">
      <div class="section-icon"></div>
      <span class="section-title">User Resources</span>
    </div>
    <div class="cards">

      <div class="card">
        <div class="card-title">Quick Start</div>
        <div class="card-desc">Get up and running with TRUST in minutes.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/QuickStart.html" target="_blank">&#8599; Open guide</a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">User Tutorials</div>
        <div class="card-desc">Step-by-step tutorials covering common use cases.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/UserTutorials.html" target="_blank">&#8599; Browse tutorials</a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Test Cases List</div>
        <div class="card-desc">Reference test cases for validation.</div>
        <div class="card-links">
          <a href="tests/References.html">&#8599; Test cases</a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Script Memo</div>
        <div class="card-desc">Quick reference for available TRUST scripts and tools.</div>
        <div class="card-links">
          <a href="bin/README">&#8599; View memo</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Section: Developer Resources -->
  <section class="section">
    <div class="section-header">
      <div class="section-icon"></div>
      <span class="section-title">Developer Resources</span>
    </div>
    <div class="cards">

      <div class="card">
        <div class="card-title">Baltik Tutorial</div>
        <div class="card-desc">Learn how to build BALTIK applications on top of TRUST.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/DevTutorials.html" target="_blank">&#8599; Online <span class="badge">web</span></a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">ICoCo Tutorial</div>
        <div class="card-desc">Interface for Code Coupling - integration guide.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/Dev_ICoco.html" target="_blank">&#8599; Online <span class="badge">web</span></a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">C++ API Reference</div>
        <div class="card-desc">Browse the auto-generated Doxygen class documentation.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/usergroup0.html" target="_blank">&#8599; Online <span class="badge">web</span></a>
          <a href="docs/build/html/index.html">&#8599; Offline - <em>run <code>make docs</code> first</em></a>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Validation form API: trustutils</div>
        <div class="card-desc">Jupyter/stats package docs.</div>
        <div class="card-links">
          <a href="https://cea-trust-platform.readthedocs.io/en/${READTHEDOCS_LABEL}/Dev_ValidationFormAPI.html" target="_blank">&#8599; trustutils docs</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Section: Download & Support; edit href="mailto:..." to change contact -->
  <section class="section">
    <div class="section-header">
      <div class="section-icon"></div>
      <span class="section-title">Download &amp; Support</span>
    </div>
    <div class="contact-strip">
      <div>
        <strong>Need help?</strong>
        <p>Reach out to the TRUST support team or explore the community resources.</p>
      </div>
      <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
        <a href="https://github.com/cea-trust-platform/trust-code#readme" class="btn btn-primary" target="_blank">GitHub</a>
        <a href="https://cea-trust-platform.github.io/" class="btn btn-secondary" target="_blank">TRUST Website</a>
        <a href="mailto:trust@cea.fr" class="btn btn-secondary">Contact</a>
      </div>
    </div>
  </section>

</main>

<!-- Footer -->
<footer>
  TRUST Platform ${VERSION} - CEA &nbsp;&middot;&nbsp;
  <a href="https://github.com/cea-trust-platform/trust-code" target="_blank">GitHub</a> &nbsp;&middot;&nbsp;
  <a href="https://cea-trust-platform.github.io/" target="_blank">Website</a>
</footer>

<script>
  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    document.getElementById('theme-icon').textContent  = theme === 'dark' ? '\u2600\uFE0F' : '\uD83C\uDF19';
    document.getElementById('theme-label').textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
  }

  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  let userChoice = null; // set once the user clicks the toggle (runtime only)

  function toggleTheme() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    userChoice = isDark ? 'light' : 'dark';
    applyTheme(userChoice);
  }

  applyTheme(prefersDark.matches ? 'dark' : 'light');

  // Follow OS preference changes until the user picks a theme explicitly.
  prefersDark.addEventListener('change', function (e) {
    if (!userChoice) applyTheme(e.matches ? 'dark' : 'light');
  });

  // Colorblind-friendly palette toggle (runtime only, off by default).
  let cbOn = false;

  function applyCb(on) {
    document.documentElement.setAttribute('data-cb', on ? 'on' : 'off');
    document.getElementById('cb-label').textContent = on ? 'Standard colors' : 'Colorblind';
  }

  function toggleCb() {
    cbOn = !cbOn;
    applyCb(cbOn);
  }

  applyCb(false);
</script>

</body>
</html>
