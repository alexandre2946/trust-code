# Case copied/amended from upwind. The physics make no sense here
  the idea is just to show the effect of the entity renumbering via 
  the Morton or Hilbert algorithm #

dimension $dim
Pb_hydraulique pb
Domaine dom
# BEGIN MESH #

Mailler dom 
{
	Pave Entree
	{
	    Origine 0. 0. $OZ
	    Nombre_de_Noeuds $NX  $NY $NZ
	    Longueurs 1 1 $LZ
	}
	{
	bord gauche X = 0. 0. <= Y <= 1.0  $ZCOND
    bord droite X = 1. 0. <= Y <= 1.   $ZCOND
		
	bord bas  Y = 0.0  0. <= X <= 1   $ZCOND
	bord haut Y = 1.0  0. <= X <= 1   $ZCOND
	
	$BOUND_Z
	
	}
}

$DISC

Scheme_euler_explicit sch
Read sch
{
    tinit 0
/*    tmax 2.5 */
    /* dt_min identique au dt_max alors dt=dt_min=dt_max */
    dt_min 5.e-3
    dt_max 5.e-3
    dt_impr 5.e-1
    dt_sauv 1
    seuil_statio 1.e-8
    nb_pas_dt_max 3 /* we juste care about the reordering */
}

Associate pb dom
Associate pb sch
Discretize pb dis

postraiter_domaine { domaine dom format lata }

end

Read pb
{

    fluide_incompressible {
        mu Champ_Uniforme 1 3.7e-05
        rho Champ_Uniforme 1 2
    }

    Navier_Stokes_standard
    {
        solveur_pression GCP {
            precond ssor { omega 1.5 }
            seuil 1.e-8 impr
        }
        convection { amont }
        diffusion {  }
        # Conditions initiales sur la vitesse #
        initial_conditions {
            vitesse Champ_Uniforme $dim 0. 0. $OZ
        }
        boundary_conditions {
            gauche frontiere_ouverte_vitesse_imposee champ_front_uniforme $dim 0 1 $OZ
            droite frontiere_ouverte_pression_imposee champ_front_uniforme 1 0 
            haut paroi_fixe
            bas symetrie
            $BC_Z
        }
    }

    Post_processing
    {
        Format med
        fields dt_post 10000
        {
            pression elem
            vitesse faces
        }
    }
}

Solve pb

End

