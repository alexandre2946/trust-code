# PARALLEL OK 8 #
dimension 2
Domaine dom

# BEGIN MESH #
mailler dom
{
    pave carre
    {
        origine  0.0  0.0
        nombre_de_noeuds  $__n__ 2
        longueurs 1 1
    }
    {
        bord  bas       Y = 0.0    0.0 <= X <= 1.0
        bord  haut      Y = 1.0    0.0 <= X <= 1.0
        bord  gauche    X = 0.0    0.0 <= Y <= 1.0
        bord  droite    X = 1.0    0.0 <= Y <= 1.0
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 4 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #

Scheme_euler_explicit sch
Read sch

{
    tinit 0
    dt_min 5.e-40
    dt_max  0.8
    tmax $__tmax__
    seuil_statio -1
    facsec 0.8
}

Coloc dis

Pb_Euler pb

Associate  pb dom
Associate  pb sch
Discretize pb dis

Read pb
{
    Milieu_composite_Euler
    {
        gaz StiffenedGas { gamma $__gamma__ pinf $__pinf__ }
    }

    Fraction_Euler
    {
        initial_conditions
        {
            alpha Champ_composite 1
            {
                Champ_Uniforme 1 1
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    Masse_Euler
    {
        convection { hll }
        initial_conditions
        {
            densite Champ_composite 1
            {
                Champ_fonc_xyz dom 1 $__rl__*(x[$__x__)+$__rr__*(x>$__x__)
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    QDM_Euler
    {
        convection { hll }
        initial_conditions
        {
            vitesse Champ_composite 1
            {
                Champ_fonc_xyz dom 2 $__vl__*(x[$__x__)+($__vr__)*(x>$__x__) 0
            }

            pression Champ_composite 1
            {
                Champ_fonc_xyz dom 1 $__pl__*(x[$__x__)+$__pr__*(x>$__x__)
            }
        }

        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    Energie_Euler
    {
        convection { hll }
        initial_conditions
        {
            Energie_tot Champ_composite 1
            {
                Champ_Uniforme 1 -800
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    Post_processing
    {
        probes
        {
            rho grav densite periode 1e8 segment 1000 0 0.5 1 0.5
            v grav         vitesse periode 1e8 segment 1000 0 0.5 1 0.5
            p grav        pression periode 1e8 segment 1000 0 0.5 1 0.5
        }

        Format cgns
        fields dt_post 1e-2
        {
            densite elem
            vitesse elem
            pression elem
        }
    }
}
Solve pb
End
