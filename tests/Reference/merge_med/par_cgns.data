# Hydraulique 2D laminaire avec "trou" dans le maillage #
# PARALLEL ONLY 4 #
dimension 2
Pb_hydraulique pb
Domaine dom

option_cgns { SINGLE_FILE_PER_COMM_GROUP }

My_Comm_Group
{
    Group_nb 2
}

# BEGIN MESH
Read_file upwind.geo ;
END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool tranche { tranches 2 2 }
    Larg_joint 1
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER #
Scatter DOM.Zones dom
# END SCATTER #

VDF dis

Scheme_euler_explicit sch
Read sch
{
    tinit 0
    tmax 2.5
    dt_min 5.e-3
    dt_max 5.e-3
    dt_impr 5.e-1
    dt_sauv 1
    seuil_statio 1.e-8
}

Associate pb dom
Associate pb sch
Discretize pb dis

Read pb
{

    fluide_incompressible {
        mu Champ_Uniforme 1 3.7e-05
        rho Champ_Uniforme 1 2
    }


    Navier_Stokes_standard
    {
        solveur_pression GCP {
            precond ssor { omega 1.5 }
            seuil 1.e-8 impr
        }
        convection { amont }
        diffusion {  }
        initial_conditions {
            vitesse Champ_Uniforme 2 0. 0.
        }
        boundary_conditions {
            Obstacle paroi_fixe
            Symetrie symetrie
            Sortie frontiere_ouverte_pression_imposee
            Champ_front_Uniforme 1 0.
            Entree frontiere_ouverte_vitesse_imposee
            Champ_front_Uniforme 2  1. 0.
        }
    }

    Post_processing
    {
        Format cgns
        fields dt_post 1.3
        {
          pression elem
          vitesse elem
          masse_volumique elem
          gradient_pression elem
          pression som
          vitesse som
          masse_volumique som
          gradient_pression som
          vitesse faces
        }
    }
    
}
Solve pb

cgns_to_lata NOM_DU_CAS NOM_DU_CAS

End
