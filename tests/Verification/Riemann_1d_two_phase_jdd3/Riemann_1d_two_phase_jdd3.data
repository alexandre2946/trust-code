# PARALLEL OK 8 #
dimension 2
Domaine dom

# BEGIN MESH #
mailler dom
{
    pave tube
    {
        origine  0.0  0.0
        nombre_de_noeuds  201 2
        longueurs 1 1
    }
    {
        bord  bas       Y = 0.0    0.0 <= X <= 1.0
        bord  haut      Y = 1.0    0.0 <= X <= 1.0
        bord  gauche    X = 0.0    0.0 <= Y <= 1.0
        bord  droite    X = 1.0    0.0 <= Y <= 1.0
    }
}
# END MESH #

# BEGIN PARTITION
Decouper dom
{
    partitionneur metis { nb_parts 2 }
    nb_parts_tot 2
    Larg_joint 2
    Nom_Zones dom
}
Fin
END PARTITION #

# BEGIN SCATTER
Scatter dom.Zones dom
END SCATTER #

Scheme_euler_explicit sch
Read sch

{
    tinit 0
	nb_pas_dt_max 3
    dt_min 5.e-40
    dt_max  0.5
    tmax 0.007
    seuil_statio -1
    facsec 0.4
}



Coloc dis 

Pb_Euler pb

Associate  pb dom
Associate  pb sch
Discretize pb dis

Read pb
{   Milieu_composite_Euler
    {     
         solide StiffenedGas { gamma 3 pinf 100 }
         gaz StiffenedGas { gamma 1.4 pinf 0. }
         interface Interface_Baer_Nunziato { vitesse 0 pression 1 }
    } 
    
    Fraction_Euler
    {
        termes_non_conservatifs { hll }
        initial_conditions
        {
            alpha Champ_composite 2
            {
               Champ_fonc_xyz dom 1 0.7*(x[0.8)+0.2*(x>0.8)
               Champ_fonc_xyz dom 1 0.3*(x[0.8)+0.8*(x>0.8)
            } 
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }
    
    # correlations
    {
        flux_interfacial coef_constant { liquide_sodium 1e10 gaz_sodium 1e10 }
    }
    #
    
    Masse_Euler
    {
        convection { hll }
        initial_conditions
        {
            densite Champ_composite 2
            {
                # Champ_Uniforme 1 1 #
                Champ_fonc_xyz dom 1 1*(x[0.8)+1*(x>0.8)
                Champ_fonc_xyz dom 1 1*(x[0.8)+1*(x>0.8)
            } 
        }
       boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }
       
    QDM_Euler
    {
        # evanescence { homogene { alpha_res 1 alpha_res_min 0.5 } } #
        solveur_pression petsc cli_quiet { -pc_type hypre -pc_hypre_type boomeramg }  
        convection { hll }
        termes_non_conservatifs { hll }
        diffusion  { negligeable }
        initial_conditions
        {
            vitesse Champ_composite 2
            {   
                # Champ_Uniforme 2 0 0 #
                Champ_fonc_xyz dom 2 -19.5975*(x[0.8)+(-19.5975)*(x>0.8) 0
                Champ_fonc_xyz dom 2 -19.5975*(x[0.8)+(-19.5975)*(x>0.8) 0
            }

            pression Champ_composite 2
            {
                Champ_fonc_xyz dom 1 1000*(x[0.8)+0.01*(x>0.8)
                Champ_fonc_xyz dom 1 1000*(x[0.8)+0.01*(x>0.8)
            }
        }
        boundary_conditions
        {
        gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
    }
    }
        Energie_Euler
    {
        # diffusion { negligeable } #
        convection { hll }
        termes_non_conservatifs { hll }
         initial_conditions
        {
            Energie_tot Champ_composite 2
            {
                 Champ_Uniforme 1 -800
                 Champ_Uniforme 1 -800
            }
        } 
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
         # sources
        {
            puissance_thermique Champ_composite 2
            {
                champ_uniforme 1 1e8
                champ_uniforme 1 0
            } ,
            flux_interfacial
        } #
    }

    
    Post_processing
    {
       probes
        {   
             alpha_Solide grav alpha_solide periode 1e8 segment 1000 0 0.5 1 0.5 
             alpha_Gaz grav alpha_gaz periode 1e8 segment 1000 0 0.5 1 0.5 
             rho_Solide grav densite_solide periode 1e8 segment 1000 0 0.5 1 0.5
             rho_Gaz grav densite_gaz periode 1e8 segment 1000 0 0.5 1 0.5 
             v_Solide grav  vitesse_solide  periode 1e8 segment 1000 0 0.5 1 0.5 
             v_Gaz grav  vitesse_gaz  periode 1e8 segment 1000 0 0.5 1 0.5
             p_Solide grav pression_solide periode 1e8 segment 1000 0 0.5 1 0.5 
             p_Gaz grav  pression_gaz periode 1e8 segment 1000 0 0.5 1 0.5 
            
        }
        

        Format lml
        fields dt_post 1e-2
        {   
            alpha elem 
            densite elem
            alpha_rho_u elem
            vitesse_gaz elem
            vitesse_solide elem
            # Energie_tot_gaz elem #
            pression elem
        }
    }
}
Solve pb
End
