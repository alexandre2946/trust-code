# Case copied/amended from upwind. The physics make no sense here
  the idea is just to show the effect of the entity renumbering via 
  the Morton or Hilbert algorithm #

dimension 3
Pb_hydraulique pb
Domaine dom
# BEGIN MESH #

Mailler dom 
{
	Pave Entree
	{
	    Origine 0. 0. 0.
	    Nombre_de_Noeuds 5  5 5
	    Longueurs 1 1 1.0
	}
	{
	bord gauche X = 0. 0. <= Y <= 1.0   0. <= Z <= 1.0 
    bord droite X = 1. 0. <= Y <= 1.    0. <= Z <= 1.0 
		
	bord bas  Y = 0.0  0. <= X <= 1    0. <= Z <= 1.0 
	bord haut Y = 1.0  0. <= X <= 1    0. <= Z <= 1.0 
	
	bord front Z = 0.0 0.  <= X <= 1  0. <= Y <= 1.0 
               bord back Z = 1.0 0.   <= X <= 1  0. <= Y <= 1.0
	
	}
}


tetraedriser dom 
VEFPreP1b dis 
read dis { P0 P1 changement_de_base_P1bulle 1 
   reorder { algo Hilbert
             dump }
}

Scheme_euler_explicit sch
Read sch
{
    tinit 0
	nb_pas_dt_max 3
/*    tmax 2.5 */
    /* dt_min identique au dt_max alors dt=dt_min=dt_max */
    dt_min 5.e-3
    dt_max 5.e-3
    dt_impr 5.e-1
    dt_sauv 1
    seuil_statio 1.e-8
}

Associate pb dom
Associate pb sch
Discretize pb dis

postraiter_domaine { domaine dom format lml }

end

Read pb
{

    fluide_incompressible {
        mu Champ_Uniforme 1 3.7e-05
        rho Champ_Uniforme 1 2
    }

    Navier_Stokes_standard
    {
        solveur_pression GCP {
            precond ssor { omega 1.5 }
            seuil 1.e-8 impr
        }
        convection { amont }
        diffusion {  }
        # Conditions initiales sur la vitesse #
        initial_conditions {
            vitesse Champ_Uniforme 3 0. 0. 0.
        }
        boundary_conditions {
            gauche frontiere_ouverte_vitesse_imposee champ_front_uniforme 3 0 1 0.
            droite frontiere_ouverte_pression_imposee champ_front_uniforme 1 0 
            haut paroi_fixe
            bas symetrie
            front paroi_fixe 
           back symetrie
        }
    }

    Post_processing
    {
        Format med
        fields dt_post 10000
        {
            pression elem
            vitesse
        }
    }
}

Solve pb

End

