# PARALLEL OK 8 #
dimension 2
Domaine dom

# BEGIN MESH #
mailler dom
{
    pave tube
    {
        origine  0.0  0.0
        nombre_de_noeuds  201 2
        longueurs 1 1
    }
    {
        bord  bas       Y = 0.0    0.0 <= X <= 1.0
        bord  haut      Y = 1.0    0.0 <= X <= 1.0
        bord  gauche    X = 0.0    0.0 <= Y <= 1.0
        bord  droite    X = 1.0    0.0 <= Y <= 1.0
    }
}
# END MESH #

# BEGIN PARTITION
Decouper dom
{
    partitionneur metis { nb_parts 2 }
    nb_parts_tot 2
    Larg_joint 2
    Nom_Zones dom
}
Fin
END PARTITION #

# BEGIN SCATTER
Scatter dom.Zones dom
END SCATTER #

Scheme_euler_explicit sch
Read sch

{
    tinit 0
	nb_pas_dt_max 3
    dt_min 5.e-40
    dt_max  0.5
    tmax 0.05
    seuil_statio -1
    facsec 0.4
}

Coloc dis

Pb_Euler pb

Associate  pb dom
Associate  pb sch
Discretize pb dis

Read pb
{
    Milieu_composite_Euler
    {
        solide StiffenedGas { gamma 1.6 pinf 0 }
        gaz StiffenedGas { gamma 1.4 pinf 0. }
        interface Interface_Baer_Nunziato { velocity_from_phase solide }
    }

    Fraction_Euler
    {
        termes_non_conservatifs { hll }
        initial_conditions
        {
            alpha Champ_composite 2
            {
                Champ_fonc_xyz dom 1 0.5*(x[0.5)+0.6*(x>0.5)
                Champ_fonc_xyz dom 1 0.5*(x[0.5)+0.4*(x>0.5)
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    Masse_Euler
    {
        convection { hll }
        initial_conditions
        {
            densite Champ_composite 2
            {
                # Champ_Uniforme 1 1 #
                Champ_fonc_xyz dom 1 1.1969795*(x[0.5)+1.2954081*(x>0.5)
                Champ_fonc_xyz dom 1 0.3*(x[0.5)+0.49045078*(x>0.5)
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    QDM_Euler
    {
        convection { hll }
        termes_non_conservatifs { hll }
        initial_conditions
        {
            vitesse Champ_composite 2
            {
                # Champ_Uniforme 2 0 0 #
                Champ_fonc_xyz dom 2 -0.70474276*(x[0.5)+(0.51451306)*(x>0.5) 0
                Champ_fonc_xyz dom 2 5*(x[0.5)+(4.9606427)*(x>0.5) 0
            }

            pression Champ_composite 2
            {
                Champ_fonc_xyz dom 1 4*(x[0.5)+4.5391218*(x>0.5)
                Champ_fonc_xyz dom 1 0.2*(x[0.5)+0.39810826*(x>0.5)
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    Energie_Euler
    {
        convection { hll }
        termes_non_conservatifs { hll }
        initial_conditions
        {
            Energie_tot Champ_composite 2
            {
                Champ_Uniforme 1 -800
                Champ_Uniforme 1 -800
            }
        }
        boundary_conditions
        {
            gauche Sortie_supersonique
            droite Sortie_supersonique
            bas Sortie_supersonique
            haut Sortie_supersonique
        }
    }

    Post_processing
    {
        probes
        {
            alpha_Solide grav alpha_solide periode 1e8 segment 1000 0 0.5 1 0.5
            alpha_Gaz grav alpha_gaz periode 1e8 segment 1000 0 0.5 1 0.5
            rho_Solide grav densite_solide periode 1e8 segment 1000 0 0.5 1 0.5
            rho_Gaz grav densite_gaz periode 1e8 segment 1000 0 0.5 1 0.5
            v_Solide grav  vitesse_solide  periode 1e8 segment 1000 0 0.5 1 0.5
            v_Gaz grav  vitesse_gaz  periode 1e8 segment 1000 0 0.5 1 0.5
            p_Solide grav pression_solide periode 1e8 segment 1000 0 0.5 1 0.5
            p_Gaz grav  pression_gaz periode 1e8 segment 1000 0 0.5 1 0.5
        }

        Format lml
        fields dt_post 1e-2
        {
            alpha elem
            densite elem
            alpha_rho_u elem
            vitesse_gaz elem
            vitesse_solide elem
            # Energie_tot_gaz elem #
            pression elem
        }
    }
}
Solve pb
End
