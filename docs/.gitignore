# The root .gitignore excludes all files named "Makefile".
# Override that rule here so the doc build system is tracked.
!Makefile

# Everything generated by the doc pipeline lives under build/:
#   build/generated_content/   keyword reference, trustutils API pages
#   build/html/                doxygen output
build/

# a venv is necessary to install trustify trust is not configured/sourced
.venv
